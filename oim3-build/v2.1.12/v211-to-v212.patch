+
+bool valid_hash_hex(const std::string &value)
+{
+    if (value.size() != MANIFEST_HASH_HEX_BYTES) return false;
+    for (unsigned char c : value) {
+        if (!std::isxdigit(c)) return false;
+    }
+    return true;
+}
+
+bool parse_manifest_sensors(const std::string &raw, std::vector<ManifestSensor> &out)
+{
+    out.clear();
+    if (raw.empty() || raw.size() > MAX_MANIFEST_SENSORS_BYTES) return false;
+    std::size_t start = 0;
+    while (start < raw.size()) {
+        const std::size_t comma = raw.find(',', start);
+        const std::string item = raw.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+        const std::size_t colon = item.find(':');
+        if (colon == std::string::npos || colon == 0U || colon + 1U >= item.size()) return false;
+        const std::string driver = item.substr(0, colon);
+        const std::string inst = item.substr(colon + 1U);
+        if (inst != "1") return false;
+        if (driver != "SHT45" && driver != "BATTERY") return false;
+        for (const auto &existing : out) {
+            if (existing.driver == driver && existing.instance == 1U) return false;
+        }
+        out.push_back(ManifestSensor{driver, 1U});
+        if (comma == std::string::npos) break;
+        start = comma + 1U;
+    }
+    return !out.empty();
+}
+
+void use_legacy_default_manifest()
+{
+    g_manifest = DeviceManifest{};
+    g_manifest.serial = g_identity.serial;
+    g_manifest.version = 1U;
+    g_manifest.sensors = {ManifestSensor{"SHT45", 1U}, ManifestSensor{"BATTERY", 1U}};
+    g_manifest.valid = true;
+    g_manifest.legacy_default = true;
+    ESP_LOGW(TAG, "Factory manifest missing; using legacy SHT45:1,BATTERY:1 fallback for serial=%s",
+             g_manifest.serial.c_str());
+}
+
+bool load_manifest()
+{
+    g_manifest = DeviceManifest{};
+    nvs_handle_t handle{};
+    const esp_err_t open_err = nvs_open_from_partition(
+        PARTITION_LABEL, MANIFEST_NAMESPACE, NVS_READONLY, &handle);
+    if (open_err == ESP_ERR_NVS_NOT_FOUND) {
+        use_legacy_default_manifest();
+        return true;
+    }
+    if (open_err != ESP_OK) {
+        ESP_LOGE(TAG, "Factory manifest open failed: %s", esp_err_to_name(open_err));
+        return false;
+    }
+
+    uint32_t schema = 0;
+    uint32_t version = 0;
+    std::string sensors_raw;
+    const bool read_ok =
+        nvs_get_u32(handle, "schema", &schema) == ESP_OK &&
+        schema == MANIFEST_SCHEMA_VERSION &&
+        nvs_get_string(handle, MANIFEST_SERIAL_KEY, g_manifest.serial, true, MAX_SERIAL_BYTES) &&
+        nvs_get_u32(handle, MANIFEST_VERSION_KEY, &version) == ESP_OK && version >= 1U &&
+        nvs_get_string(handle, MANIFEST_SENSORS_KEY, sensors_raw, true, MAX_MANIFEST_SENSORS_BYTES) &&
+        nvs_get_string(handle, MANIFEST_HASH_KEY, g_manifest.hash, true, MANIFEST_HASH_HEX_BYTES);
+    nvs_close(handle);
+
+    if (!read_ok || g_manifest.serial != g_identity.serial ||
+        !parse_manifest_sensors(sensors_raw, g_manifest.sensors) ||
+        !valid_hash_hex(g_manifest.hash)) {
+        ESP_LOGE(TAG, "Factory manifest invalid or serial mismatch; customer operation blocked");
+        return false;
+    }
+    g_manifest.version = version;
+    g_manifest.valid = true;
+    g_manifest.legacy_default = false;
+    ESP_LOGI(TAG, "Factory manifest: serial=%s version=%lu sensors=%s hash=%s",
+             g_manifest.serial.c_str(), static_cast<unsigned long>(g_manifest.version),
+             sensors_raw.c_str(), g_manifest.hash.c_str());
+    return true;
+}
