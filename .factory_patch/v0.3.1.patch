+    def _idf_tools_candidates(self) -> list[Path]:
+        candidates: list[Path] = []
+
+        configured = str(getattr(self.settings, "idf_tools_path", "") or "").strip()
+        if configured:
+            candidates.append(Path(configured))
+
+        env_tools = os.environ.get("IDF_TOOLS_PATH", "").strip()
+        if env_tools:
+            candidates.append(Path(env_tools))
+
+        raw_python = str(self.settings.idf_python or "").strip()
+        if raw_python:
+            py = Path(raw_python)
+            for parent in py.parents:
+                if parent.name.lower() == "espressif":
+                    candidates.append(parent)
+                    break
+
+        if os.name == "nt":
+            candidates.append(Path(r"C:\Espressif"))
+            userprofile = os.environ.get("USERPROFILE", "").strip()
+            if userprofile:
+                candidates.append(Path(userprofile) / ".espressif")
+
+        unique: list[Path] = []
+        seen: set[str] = set()
+        for item in candidates:
+            key = str(item).lower()
+            if key not in seen:
+                seen.add(key)
+                unique.append(item)
+        return unique
+
+    def idf_tools_path(self) -> Path | None:
+        for path in self._idf_tools_candidates():
+            if path.is_dir():
+                return path
+        return None
