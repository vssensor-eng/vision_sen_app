+def next_manifest_version_for_sensor_change(current_version: int, baseline_version: int, baseline_sensor_keys, selected_sensor_keys) -> int:
+    """Return a monotonic manifest version for a physical sensor-set change."""
+    current = max(1, int(current_version))
+    baseline = max(0, int(baseline_version))
+    if baseline < 1:
+        return current
+    before = normalize_manifest_sensor_keys(baseline_sensor_keys)
+    after = normalize_manifest_sensor_keys(selected_sensor_keys)
+    if before != after and current <= baseline:
+        return baseline + 1
+    return current
 
 
