+    def _place_initial_log_sash(self) -> None:
+        """Place the right-side technical log at about one third of usable width."""
+        try:
+            width = max(1180, int(self.main_pane.winfo_width() or self.winfo_width() or 1500))
+            self.main_pane.sash_place(0, int(width * 0.68), 0)
+        except Exception:
+            pass
+
+    def _scroll_log_if_enabled(self) -> None:
+        try:
+            if getattr(self, "log_autoscroll_var", None) is None or self.log_autoscroll_var.get():
+                self.log_text.see("end")
+        except Exception:
+            pass
+
+    def copy_log(self) -> None:
+        try:
+            text = self.log_text.get("1.0", "end-1c")
+            self.clipboard_clear()
+            self.clipboard_append(text)
+            self.global_status.configure(text="Teknik log panoya kopyalandı", fg=self._ui_colors["green"])
+        except Exception as exc:
+            messagebox.showerror("Log Kopyalama Hatası", str(exc))
+
+    def save_log(self) -> None:
+        path_text = filedialog.asksaveasfilename(
+            title="Teknik Logu Kaydet",
+            defaultextension=".log",
+            filetypes=[("Log dosyası", "*.log"), ("Metin dosyası", "*.txt"), ("Tüm dosyalar", "*.*")],
+            initialfile=f"VisionSen-Factory-{datetime.now().strftime('%Y%m%d-%H%M%S')}.log",
+        )
+        if not path_text:
+            return
+        try:
+            Path(path_text).write_text(self.log_text.get("1.0", "end-1c"), encoding="utf-8")
+            self.global_status.configure(text="Teknik log kaydedildi", fg=self._ui_colors["green"])
+        except Exception as exc:
+            messagebox.showerror("Log Kaydetme Hatası", str(exc))
+
